<!DOCTYPE html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
  </head>
  <body>
    <h1>Добавление пользователя</h1>
    <form action="/add_user" method="post">
      <div>
        <label for="name_user">Имя пользователя</label>
        <input type="text" id="name_user" name="name_user" placeholder="Введите имя пользователя">
      </div>

      <div>
        <label for="password_user">Пароль</label>
        <input type="text" id="password_user" name="password_user">
      </div>

      <div>
        <label for="UserGroup">Группа пользователя</label>
        <select name="UserGroup" id="UserGroup">
          <option value="" disabled selected>Выберите группу пользователя</option>
          <% for (const key in type) { %>
            <% const onetype = type[key]; %>
            <option value="<%= key %>">
              <%= onetype.label %>
            </option>
          <% } %>
        </select>
      </div>

      <button type="submit">Добавить</button>
    </form>
  </body>
</html>