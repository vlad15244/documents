<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <title><%= title %></title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <% if (user) { %>
        <p>Текущий пользователь: <%= user.USER_NAME %>!</p>
    <% } %>
<table id="table_order">
  <thead>
    <tr>
      <th>ID пользователя</th>
      <th>Имя пользователя</th>
      <th>Группа</th> 
    </tr>
  </thead>
  <tbody>
    <% if (rows && rows.length > 0) { %>
      <% rows.forEach(row => { %> 
        <tr>
          <td><%= row.ID %></td>
          <td><%= row.USER_NAME %></td>
          <td>
            <%= type[row.GROUP_USER] ? type[row.GROUP_USER].label : row.GROUP_USER %>
          </td>
          <td style="text-align: center; vertical-align: middle;">
            <form action="/delete_user/<%= row.ID %>" method="get">
              <button type="submit" style="padding: 5px 10px; background-color: #ffcccc;">Удалить</button>
            </form>
          </td>                                     
        </tr>
      <% }); %>
    <% } else { %>
      <tr>
        <td colspan="6" style="text-align:center;">Список пользоватей пуст</td>
    </tr>
    <% } %>
  </tbody>
</table>
   <form action="/add_user" method="get">
    <button class = "in_cell" type="submit">Добавить пользователя</button>
  </form> 
<table id="table_actions">
  <thead>
    <tr>
      <th>ID</th>
      <th>Время</th>
      <th>Пользователь</th>
      <th>Действие</th>       
    </tr>
  </thead>
  <tbody>
    <% if (actions && actions.length > 0) { %>
      <% actions.forEach(action => { %> 
        <tr>
          <td><%= action.ID %></td>
          <td><%= action.formattedDate %></td>
          <td><%= action.USER_NAME %></td> 
          <td><%= action.ACTION %></td>                                               
        </tr>
      <% }); %>
    <% } else { %>
      <tr>
        <td colspan="6" style="text-align:center;">Список действий пуст</td>
    </tr>
    <% } %>
  </tbody>
</table>


   <form action="/" method="get">
    <button class = "in_cell" type="submit">Выход из панели администрирования</button>
  </form>   
</body>
